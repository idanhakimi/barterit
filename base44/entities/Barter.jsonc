{
  "name": "Barter",
  "type": "object",
  "properties": {
    "user1_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df"
    },
    "user2_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e9\u05e0\u05d9"
    },
    "user1_service": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05e0\u05ea\u05df"
    },
    "user2_service": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e9\u05e0\u05d9 \u05e0\u05ea\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e2\u05e1\u05e7\u05d4"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e9\u05dc\u05de\u05ea \u05d4\u05e2\u05e1\u05e7\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e2\u05e1\u05e7\u05d4"
    }
  },
  "required": [
    "user1_id",
    "user2_id",
    "user1_service",
    "user2_service"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user1_id": "{{user.id}}"
        },
        {
          "user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user1_id": "{{user.id}}"
        },
        {
          "user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}