{
  "name": "BarterMeeting",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4"
    },
    "organizer_id": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d9\u05e6\u05e8 \u05d0\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "participant_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e9\u05ea\u05ea\u05e3 \u05d4\u05e9\u05e0\u05d9"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "proposed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4 \u05de\u05d5\u05e6\u05e2\u05d9\u05dd"
    },
    "location_text": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "organizer_service": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05d0\u05e8\u05d2\u05df \u05e0\u05d5\u05ea\u05df"
    },
    "participant_service": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05e9\u05ea\u05ea\u05e3 \u05e0\u05d5\u05ea\u05df"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "match_id",
    "organizer_id",
    "participant_id",
    "proposed_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "organizer_id": "{{user.id}}"
        },
        {
          "participant_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "organizer_id": "{{user.id}}"
        },
        {
          "participant_id": "{{user.id}}"
        }
      ]
    }
  }
}