{
  "name": "Block",
  "type": "object",
  "properties": {
    "blocker_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d7\u05d5\u05e1\u05dd"
    },
    "blocked_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e0\u05d7\u05e1\u05dd"
    }
  },
  "required": [
    "blocker_id",
    "blocked_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "blocker_id": "{{user.id}}"
        },
        {
          "blocked_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "blocker_id": "{{user.id}}"
    }
  }
}