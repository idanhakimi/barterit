{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "campaign_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "subject": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05de\u05d9\u05d9\u05dc"
    },
    "body": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d9\u05d9\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05e9\u05dc\u05d7\u05d4"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05d4 \u05de\u05ea\u05d5\u05db\u05e0\u05df"
    }
  },
  "required": [
    "campaign_name",
    "subject",
    "body"
  ]
}