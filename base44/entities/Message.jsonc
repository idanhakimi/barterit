{
  "name": "Message",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4"
    },
    "sender_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d5\u05dc\u05d7"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e0\u05e7\u05e8\u05d0\u05d4"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "system"
      ],
      "default": "text",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    }
  },
  "required": [
    "match_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "sender_id": "{{user.id}}"
        },
        {
          "match_id": {
            "$in_related": {
              "entity": "Match",
              "$or": [
                {
                  "user1_id": "{{user.id}}"
                },
                {
                  "user2_id": "{{user.id}}"
                }
              ]
            }
          }
        }
      ]
    },
    "write": {
      "sender_id": "{{user.id}}"
    }
  }
}