{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05e7\u05d1\u05dc"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_like",
        "new_message",
        "meeting_confirmed",
        "meeting_cancelled",
        "meeting_reminder"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "body": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "from_user_id": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e9\u05dc\u05d7"
    },
    "related_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 (match/meeting)"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "user_id": "{{user.id}}"
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "from_user_id": "{{user.id}}"
        }
      ]
    }
  }
}