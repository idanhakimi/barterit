{
  "name": "Rating",
  "type": "object",
  "properties": {
    "rated_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "rating_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e0\u05ea\u05df \u05d0\u05ea \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "stars": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05db\u05d5\u05db\u05d1\u05d9\u05dd (1-5)"
    },
    "comment": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e2\u05dc \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "barter_description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05e9\u05d1\u05d5\u05e6\u05e2\u05d4"
    }
  },
  "required": [
    "rated_user_id",
    "rating_user_id",
    "stars"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "rated_user_id": "{{user.id}}"
        },
        {
          "rating_user_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "rating_user_id": "{{user.id}}"
    }
  }
}