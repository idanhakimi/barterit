{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "reported_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc\u05d9\u05d5"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "match_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4 (\u05dc\u05e7\u05d5\u05e0\u05d8\u05e7\u05e1\u05d8)"
    }
  },
  "required": [
    "reporter_id",
    "reported_id",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "reporter_id": "{{user.id}}"
    }
  }
}